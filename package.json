{
  "name": "lokalmatador-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "AWS_PROFILE=andregasser-lokalmatador-dev sst dev",
    "deploy:dev": "AWS_PROFILE=andregasser-lokalmatador-dev sst deploy --stage dev",
    "deploy:prod": "AWS_PROFILE=andregasser-lokalmatador-prod sst deploy --stage production",
    "remove:dev": "AWS_PROFILE=andregasser-lokalmatador-dev sst remove --stage dev",
    "remove:prod": "AWS_PROFILE=andregasser-lokalmatador-prod sst remove --stage production"
